{
  "name": "matriculas-guadalupe-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "API de matrículas y recaudo escolar (Express + Drizzle + Neon Postgres).",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "node ./build.mjs && node ./scripts/build-serverless.mjs",
    "build:serverless": "node ./scripts/build-serverless.mjs",
    "smoke:serverless": "node ./scripts/smoke-serverless.mjs",
    "check:csv": "tsx ./scripts/check-csv.ts",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:push": "drizzle-kit push --config ./drizzle.config.ts",
    "db:seed": "node ./scripts/seed-admin.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "postgres": "^3.4.9",
    "ws": "^8.21.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.10.5",
    "@types/ws": "^8.5.13",
    "drizzle-kit": "^0.31.10",
    "esbuild": "0.25.8",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "thread-stream": "3.1.0",
    "tsx": "^4.23.13",
    "typescript": "^5.4.3"
  }
}
